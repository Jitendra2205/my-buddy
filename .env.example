# Copy this file to .env and fill in your key. The .env file is git-ignored.

# --- Provider keys (at least one) -------------------------------------------
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Optional — enables the Anthropic provider in Admin -> Model & Tools.
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Access control ---------------------------------------------------------
# REQUIRED when hosting. Without it, anyone who can reach the URL can spend
# your API key. Ignored for loopback-only local use.
# ACCESS_PASSWORD=choose-a-long-random-passphrase
# ACCESS_USER=buddy

# --- Networking -------------------------------------------------------------
# PORT=3717
# HOST=127.0.0.1     # set to 0.0.0.0 only when deploying behind a host's proxy

# --- Model overrides --------------------------------------------------------
# MY_BUDDY_PROVIDER=gemini
# MY_BUDDY_MODEL=gemini-pro-latest
